# Set a long random secret for deployment; never commit real secrets.
SCAMSHIELD_SECRET_KEY=replace-with-a-long-random-secret
SCAMSHIELD_DB=scamshield.db
SCAMSHIELD_UPLOAD_DIR=evidence_uploads
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
SCAMSHIELD_HTTPS=0
# Optional keys are read server-side; do not place them in frontend JavaScript.
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
